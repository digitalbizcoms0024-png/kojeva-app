{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kojeva-hub",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-01",
  // Serve at kojeva-hub.<account>.workers.dev; lock it with Cloudflare Access (docs/ARCHITECTURE.md).
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kojeva-hub",
      "database_id": "3d5567bd-8374-4f81-880c-6ad59d1f0878",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "META_APP_ID": "2206600029921100",
    "META_AD_ACCOUNT_ID": "act_2930078677198801",
    "META_GRAPH_VERSION": "v26.0",
    // From Zero Trust → Access → Applications → this app. Until both are set, the app
    // refuses to connect Meta. Secrets (META_APP_SECRET, TOKEN_KEY) are set in the dashboard.
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "triggers": {
    // Nightly Meta sync, 09:17 UTC (~5am New York).
    "crons": ["17 9 * * *"]
  }
}
