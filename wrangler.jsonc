{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kojeva-hub",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-01",
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kojeva-hub",
      // Replace with the id printed by `wrangler d1 create kojeva-hub` before the first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // "sample" shows a banner in the UI; set to "live" once Meta sync is running.
    "DATA_MODE": "sample"
  }
}
