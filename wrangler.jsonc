{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kojeva-hub",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-01",
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kojeva-hub",
      "database_id": "3d5567bd-8374-4f81-880c-6ad59d1f0878",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // "sample" shows a banner in the UI; set to "live" once Meta sync is running.
    "DATA_MODE": "sample"
  }
}
